---
import 'katex/dist/katex.min.css';
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      /* Brand colors. Keep these values identical to tools/palette.py (verify_studies.py checks). */
      :root {
        color-scheme: light dark;
        --pink: #d21a52;
        --pink-text: #d21a52;
        --teal: #0e9f93;
        --gold: #e0a100;
        --blue: #2a78d6;
        --on-pink: #ffffff;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --pink: #dc2a5f;
          --pink-text: #ff7aa8;
          --teal: #10a79a;
          --gold: #c98500;
          --blue: #3987e5;
          --on-pink: #1a1a19;
        }
      }
      body { font: 16px/1.6 system-ui, sans-serif; max-width: 46rem; margin: 0 auto; padding: 1rem; }
      a { color: var(--pink-text); }
      header a { font-weight: 700; text-decoration: none; }
      h1 { text-decoration: underline; text-decoration-color: var(--pink); text-decoration-thickness: 4px; text-underline-offset: 7px; }
      h2 { margin-top: 2rem; }
      .banner { padding: .5rem .75rem; border: 1px solid var(--pink); border-radius: 6px; }
      blockquote { margin: 1rem 0; padding: .75rem 1rem; border-left: 4px solid var(--pink); border-radius: 4px; background: color-mix(in srgb, var(--pink) 9%, transparent); }
      blockquote p { margin: .4rem 0; }
      figure.chart { margin: 1.25rem 0; }
      figure.chart img { display: block; max-width: 100%; height: auto; border-radius: 6px; }
      figure.chart figcaption { margin-top: .5rem; font-size: .85rem; opacity: .8; }
      .verdict { margin: .5rem 0; }
      header a.nav { margin-left: 1rem; font-weight: 400; }
      .overlap { margin: 1rem 0; padding: .75rem 1rem; border: 1px solid var(--teal); border-radius: 6px; }
      .overlap ul { margin: .5rem 0; padding-left: 1.25rem; }
      .overlap li { margin: .35rem 0; }
      .tag { display: inline-block; padding: 0 .5rem; border: 1px solid currentColor; border-radius: 999px; font-size: .78rem; white-space: nowrap; }
      .tag-identical { background: var(--pink-text); border-color: var(--pink-text); color: var(--on-pink); }
      .tag-near { color: var(--pink-text); }
      .tag-partial { opacity: .75; }
      table.pairs { width: 100%; border-collapse: collapse; font-size: .9rem; }
      table.pairs th, table.pairs td { text-align: left; vertical-align: top; padding: .5rem .5rem; border-bottom: 1px solid color-mix(in srgb, currentColor 18%, transparent); }
      #filters { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1rem 0; }
      #filters button { font: inherit; padding: .25rem .75rem; border: 1px solid var(--pink-text); border-radius: 999px; background: transparent; color: var(--pink-text); cursor: pointer; }
      #filters button[aria-pressed="true"] { background: var(--pink-text); color: var(--on-pink); }
      #search { --pagefind-ui-primary: var(--pink-text); --pagefind-ui-text: CanvasText; --pagefind-ui-background: Canvas; --pagefind-ui-border: color-mix(in srgb, CanvasText 25%, transparent); --pagefind-ui-tag: color-mix(in srgb, CanvasText 8%, transparent); }
      @media (max-width: 40rem) {
        table.pairs, table.pairs tbody, table.pairs tr, table.pairs td { display: block; width: 100%; box-sizing: border-box; }
        table.pairs thead { display: none; }
        table.pairs tr { padding: .75rem 0; border-bottom: 1px solid color-mix(in srgb, currentColor 18%, transparent); }
        table.pairs td { border: 0; padding: .2rem 0; }
      }
      .katex-display { position: relative; overflow-x: auto; overflow-y: hidden; padding-bottom: .25rem; }
      footer { margin-top: 3rem; font-size: .85rem; opacity: .7; }
    </style>
  </head>
  <body>
    <header><a href={`${base}/`}>Studies Library</a> <a class="nav" href={`${base}/overlaps/`}>Overlap guide</a></header>
    <main><slot /></main>
    <footer>Educational content, not investment advice.</footer>
  </body>
</html>
