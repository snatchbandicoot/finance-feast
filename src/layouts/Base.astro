---
import 'katex/dist/katex.min.css';
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      :root { color-scheme: light dark; }
      body { font: 16px/1.6 system-ui, sans-serif; max-width: 46rem; margin: 0 auto; padding: 1rem; }
      .banner { padding: .5rem .75rem; border: 1px solid; border-radius: 6px; }
      blockquote { margin: 1rem 0; padding: .75rem 1rem; border-left: 4px solid; border-radius: 4px; background: color-mix(in srgb, currentColor 6%, transparent); }
      blockquote p { margin: .4rem 0; }
      figure.chart { margin: 1.25rem 0; }
      figure.chart img { display: block; max-width: 100%; height: auto; border-radius: 6px; }
      figure.chart figcaption { margin-top: .5rem; font-size: .85rem; opacity: .8; }
      .verdict { margin: .5rem 0; }
      footer { margin-top: 3rem; font-size: .85rem; opacity: .7; }
    </style>
  </head>
  <body>
    <header><a href={`${base}/`}>Studies Library</a></header>
    <main><slot /></main>
    <footer>Educational content, not investment advice.</footer>
  </body>
</html>
