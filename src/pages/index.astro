---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const studies = (await getCollection('studies')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const categories = [...new Set(studies.map((s) => s.data.category))].sort();
---
<Base title="Studies Library">
  <h1>Studies Library</h1>
  <p>Plain-language explanations of technical studies, with honest verdicts. Many studies measure nearly the same thing, so see the <a href={`${base}/overlaps/`}>overlap guide</a> before adding another one to a chart.</p>

  <link href={`${base}/pagefind/pagefind-ui.css`} rel="stylesheet" />
  <div id="search"></div>

  <nav id="filters" aria-label="Filter by category" hidden>
    <button type="button" data-cat="" aria-pressed="true">All</button>
    {categories.map((c) => <button type="button" data-cat={c} aria-pressed="false">{c}</button>)}
  </nav>

  <ul id="study-list">
    {studies.map((s) => (
      <li data-category={s.data.category}>
        <a href={`${base}/studies/${s.id}/`}>{s.data.title}</a> <small>({s.data.category})</small> — {s.data.summary}
      </li>
    ))}
  </ul>

  <script is:inline define:vars={{ base }}>
    // Filter works without a build step; with JS off the full list simply stays visible.
    const nav = document.getElementById('filters');
    nav.hidden = false;
    nav.addEventListener('click', (e) => {
      const btn = e.target.closest('button');
      if (!btn) return;
      for (const b of nav.querySelectorAll('button')) b.setAttribute('aria-pressed', String(b === btn));
      for (const li of document.querySelectorAll('#study-list li')) {
        li.hidden = btn.dataset.cat !== '' && li.dataset.category !== btn.dataset.cat;
      }
    });
    // Pagefind assets only exist after `npm run build`; skip quietly in dev.
    import(`${base}/pagefind/pagefind-ui.js`).then(
      () => new PagefindUI({ element: '#search', showSubResults: true, showImages: false, bundlePath: `${base}/pagefind/`, baseUrl: `${base}/` }),
      () => { document.getElementById('search').textContent = 'Search is available in the built site.'; },
    );
  </script>
</Base>
