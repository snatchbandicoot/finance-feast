---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const studies = await getCollection('studies');
  return studies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const verdictText = {
  essential: 'worth understanding for everyone',
  situational: 'useful in the right conditions',
  redundant: 'mostly duplicates something simpler',
  skip: 'little practical value',
}[entry.data.verdict];
---
<Base title={entry.data.title}>
  <article data-pagefind-body>
  <h1>{entry.data.title}</h1>
  {entry.data.status === 'draft' && <p class="banner">Draft: not yet reviewed.</p>}
  {entry.data.platform && <p class="banner">Specific to {entry.data.platform}.</p>}
  <p><small>{entry.data.category} · drawn as {entry.data.display === 'overlay' ? 'an overlay on price' : 'a separate panel'}{entry.data.inputs.length > 0 && ` · inputs: ${entry.data.inputs.map((i) => `${i.name} = ${i.default}`).join(', ')}`}</small></p>
  <p class="verdict"><strong>Verdict: {entry.data.verdict}</strong> — {verdictText}</p>
  <Content />
  </article>
</Base>
